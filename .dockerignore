# Keep the build context small and secret-free.
.git
.gitignore
.github
.venv
venv
.env
.env.*
!.env.example

# Local database & collected artifacts (regenerated in the image / at runtime)
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Python caches / tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Editors / assistants
.vscode/
.idea/
.claude/
