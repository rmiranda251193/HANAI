# Local development configuration. Copy to .env and replace placeholders.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI providers. Only "fake" is implemented. Do not put real secrets in this file.
AI_PROVIDER=fake
AI_MODEL=

# Online provider (not implemented yet)
OPENAI_API_KEY=
