# HANAI / DodongOS Physics AI -- environment configuration.
#
# Local development:  copy this file to `.env` and set DJANGO_DEBUG=True.
# Production:         set these as real environment variables (never commit .env).
#
# Accepted booleans: 1/true/yes/on  and  0/false/no/off  (anything else errors).

# --- Django core ---------------------------------------------------------

# Required in production (DJANGO_DEBUG not true). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Development: True. Production: leave unset or False. Never True in production.
DJANGO_DEBUG=True

# Comma-separated hostnames the site answers on. Production MUST set this to the
# real domain(s), e.g. hanai.example.org,www.hanai.example.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full origins (scheme + host) for CSRF, e.g.
#   https://hanai.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional. Defaults to UTC. Storage stays timezone-aware regardless.
DJANGO_TIME_ZONE=UTC

# --- Database ----------------------------------------------------------
#
# Unset  -> SQLite at ./db.sqlite3 (development, tests).
# Set    -> parsed for the "default" connection. Production uses PostgreSQL:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# sqlite:///relative/path.db and sqlite://:memory: are also accepted.
DATABASE_URL=

# Seconds to keep a PostgreSQL connection open for reuse (0 = close each request).
# Defaults to 600 in production, 0 in development.
DJANGO_DB_CONN_MAX_AGE=

# --- Security (production only; applied when DJANGO_DEBUG is not true) --
#
# HTTPS is assumed in production. Set to false ONLY if a load balancer already
# forces HTTPS and you do not want Django to redirect (then `check --deploy`
# will report the HTTPS-related warnings, which is expected).
DJANGO_SECURE_SSL=true
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=true

# --- Static files ----------------------------------------------------
#
# Set true in the release/build step AFTER `collectstatic` has run, to serve
# hashed + compressed assets via WhiteNoise. Leave unset for development/tests.
DJANGO_MANIFEST_STATIC=

# --- Logging ---------------------------------------------------------

DJANGO_LOG_LEVEL=INFO

# --- AI provider ---------------------------------------------------
#
# "fake" (default) needs nothing and never calls the network -- use it for
# development and tests. "openai" requires OPENAI_API_KEY. "ollama" is reserved.
AI_PROVIDER=fake
AI_MODEL=

# Required only when AI_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# Offline/local provider (not implemented yet)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
