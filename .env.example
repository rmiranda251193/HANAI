# Local development configuration. Copy to .env and replace placeholders.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI providers. Default is fake so local development and tests do not call a remote API.
# Do not put real secrets in this file.
AI_PROVIDER=fake
AI_MODEL=

# Online provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=60

# Offline/local provider (not implemented yet)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
